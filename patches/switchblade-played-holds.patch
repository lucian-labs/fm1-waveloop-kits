+        uint64_t ticks = (uint64_t)n * 65536u + t->rh_remainder;
+        uint32_t whole = (uint32_t)(ticks / period);
+        t->rh_clock += whole;
+        t->rh_remainder = (uint32_t)(ticks - (uint64_t)whole * period);
+    }
     len = (uint32_t)t->p[P_SLEN];
     len = len ? len : 1u;
     t->seq_pos += n;
